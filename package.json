{
  "name": "fundbun",
  "version": "1.0.0",
  "private": true,
  "description": "FundBun — an AI personal-finance agent that turns overspending into something you can see: the dream you could've had.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "predev": "node scripts/ocr-assets.mjs",
    "dev": "concurrently -k -n web,api -c yellow,cyan \"vite\" \"tsx watch server/index.ts\"",
    "predev:web": "node scripts/ocr-assets.mjs",
    "dev:web": "vite",
    "dev:api": "tsx watch server/index.ts",
    "prebuild": "node scripts/ocr-assets.mjs",
    "build": "tsc -b && vite build && node scripts/pwa-build.mjs",
    "prebuild:pages": "node scripts/ocr-assets.mjs",
    "build:pages": "tsc -b && vite build --base=/fundbun/ --mode pages && node scripts/pwa-build.mjs",
    "prebuild:vercel": "node scripts/ocr-assets.mjs",
    "build:vercel": "tsc -b && vite build --mode vercel && node scripts/pwa-build.mjs",
    "start": "NODE_ENV=production tsx server/index.ts",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:pwa": "npm run build:vercel && node scripts/verify-pwa.mjs --mode=vercel",
    "verify:pwa:pages": "npm run build:pages && node scripts/verify-pwa.mjs --mode=pages",
    "evidence": "tsx scripts/run-scenarios.ts",
    "demo:record": "tsx scripts/record-demo.ts",
    "screens": "tsx scripts/capture-screens.ts",
    "deck": "tsx deck/build.ts",
    "docs:export": "tsx docs/export/build.ts",
    "local": "npm run build && tsx server/local.ts",
    "local:api": "tsx server/local.ts --api-only",
    "desktop": "node scripts/desktop-build.mjs && electron desktop/app",
    "desktop:build": "node scripts/desktop-build.mjs --package",
    "desktop:build:windows": "node scripts/desktop-build.mjs --package --platform=win32 --arch=x64",
    "desktop:build:linux": "node scripts/desktop-build.mjs --package --platform=linux --arch=x64"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.132.0",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "lucide-react": "^1.52.0",
    "mammoth": "1.13.0",
    "pdfjs-dist": "6.5.438",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "read-excel-file": "9.3.14",
    "tesseract.js": "^7.0.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@tesseract.js-data/chi_sim": "1.0.0",
    "@tesseract.js-data/eng": "1.0.0",
    "@tesseract.js-data/ind": "1.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^9.2.0",
    "electron": "45.3.0",
    "esbuild": "0.28.2",
    "jsdom": "^26.0.0",
    "playwright": "^1.63.0",
    "pptxgenjs": "^4.0.1",
    "typescript": "~5.9.3",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
