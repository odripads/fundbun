# ── FundBun LLM gateway (server/index.ts) ─────────────────────────────
# Copy to .env (the real environment always wins over .env). Without a key, FundBun runs its on-device
# agent ("Bun Engine") only.

# Provider: anthropic | openai_compat | mock
# Unset → anthropic when ANTHROPIC_API_KEY is set, else openai_compat when OPENAI_COMPAT_API_KEY is set,
# else the mock only when FUNDBUN_ALLOW_MOCK=1, else no LLM (on-device engine answers).
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# default: claude-sonnet-5-5
ANTHROPIC_MODEL=claude-sonnet-5-5
# Reasoning effort sent as output_config.effort: low | medium | high | xhigh | max (default and any unknown
# value: low — chat replies are short). none / off omits the parameter (models without effort support).
ANTHROPIC_EFFORT=low
# Server-side refusal fallback (beta header server-side-fallback-2026-07-01): 1/true forces it on, 0/false off.
# Unset → on only for models that support it (claude-fable-5-1, claude-opus-5-5, claude-opus-5, claude-sonnet-5-5).
ANTHROPIC_FALLBACKS=

# Any OpenAI-compatible endpoint (e.g. DeepSeek, Qwen/DashScope) for in-region deployment.
# Must be https (http is accepted only for localhost); the key may be empty only for a localhost endpoint.
OPENAI_COMPAT_BASE_URL=https://api.deepseek.com/v1
OPENAI_COMPAT_API_KEY=
# default: deepseek-chat
OPENAI_COMPAT_MODEL=deepseek-chat

# Deterministic, network-free mock provider (tests, evidence, offline demos). 1/true lets the gateway fall back
# to the mock when no key is set, and is REQUIRED for LLM_PROVIDER=mock when NODE_ENV=production
# (fake answers must never ship by accident). Default: off.
FUNDBUN_ALLOW_MOCK=

# Port (0–65535, default 8787). The Vite dev server proxies /api here.
FUNDBUN_API_PORT=8787
# Interface to bind. Default: 127.0.0.1 in development; all interfaces when NODE_ENV=production.
FUNDBUN_API_HOST=
# Requests per minute per client IP (0–100000, default 30).
FUNDBUN_RATE_LIMIT_RPM=30
# 1/true only behind a reverse proxy you control: the client IP for rate limiting is then read from
# X-Forwarded-For, and X-Forwarded-Host also counts as the request's own host for the same-origin check.
# Default: off (otherwise any client could spoof those headers).
FUNDBUN_TRUST_PROXY=
# Comma-separated extra origins (exact scheme://host[:port], e.g. https://fundbun.example) allowed to POST to
# /api besides the request's own Host. No CORS headers are ever sent. Default: none (same-origin only).
FUNDBUN_ALLOWED_ORIGINS=
# Per-request timeout for the upstream LLM provider in ms (1000–300000, default 40000).
FUNDBUN_PROVIDER_TIMEOUT_MS=40000
